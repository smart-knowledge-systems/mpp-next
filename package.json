{
  "name": "levelset",
  "version": "0.1.0",
  "description": "TypeScript resource-leveling and project-scheduling toolkit, with readers/writers for Microsoft Project files (.mpp, .mspdi).",
  "license": "MIT",
  "author": "Russ T. Fugal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smart-knowledge-systems/levelset.git"
  },
  "homepage": "https://github.com/smart-knowledge-systems/levelset#readme",
  "bugs": {
    "url": "https://github.com/smart-knowledge-systems/levelset/issues"
  },
  "keywords": [
    "scheduling",
    "resource-leveling",
    "rcpsp",
    "project-management",
    "gantt",
    "microsoft-project",
    "mpp",
    "mspdi"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./leveling": {
      "types": "./dist/leveling.d.ts",
      "import": "./dist/leveling.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ . --fix",
    "format": "prettier -l --cache --cache-location node_modules/.cache/prettier/ --write .",
    "format:check": "prettier --cache --cache-location node_modules/.cache/prettier/ --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/exceljs": "^1.3.2",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.8.0"
  }
}
