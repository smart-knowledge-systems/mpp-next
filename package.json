{
  "name": "mpp-next",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./advanced": "./src/advanced.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ . --fix",
    "format": "prettier -l --cache --cache-location node_modules/.cache/prettier/ --write .",
    "format:check": "prettier --cache --cache-location node_modules/.cache/prettier/ --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.13",
    "@types/exceljs": "^1.3.2",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.7.3"
  }
}
